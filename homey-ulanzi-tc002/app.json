          "nl": "Schakel indicator [[indicator]] uit"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=ulanzi_tc002"
          },
          {
            "name": "indicator",
            "type": "dropdown",
            "values": [
              {
                "id": "1",
                "label": {
                  "en": "1 (top)",
                  "nl": "1 (boven)"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "2 (middle)",
